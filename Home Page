// type animation text — cycles through MERAIR's core travel words
const typingWords = ["EXPLORE", "DISCOVER", "WANDER", "ARRIVE"];
let typingWordIndex = 0;
const typingEl = document.querySelector(".typings");
if (typingEl) {
    function typingEffect() {
        const text = typingWords[typingWordIndex];
        typingEl.textContent = "";
        let i = 0;
        function typeChar() {
            typingEl.textContent = text.substring(0, i + 1);
            i++;

            if (i < text.length) {
                setTimeout(typeChar, 150);
            } else {
                setTimeout(untypeChar, 1400);
            }
        }
        function untypeChar() {
            const current = typingEl.textContent;
            if (current.length > 0) {
                typingEl.textContent = current.substring(0, current.length - 1);
                setTimeout(untypeChar, 60);
            } else {
                typingWordIndex = (typingWordIndex + 1) % typingWords.length;
                setTimeout(typingEffect, 300);
            }
        }
        typeChar();
    }
    typingEffect();
}

