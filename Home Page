/*------back-to-top------------*/
.prgoress_indicator {
    position: fixed;
    right: 26px;
    bottom: 35px;
    height: 46px;
    width: 46px;
    cursor: pointer;
    display: block;
    border-radius: 50px;
    box-shadow: inset 0 0 0 2px rgba(22, 93, 245, 0.2);
    z-index: 9999999999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transform: translateY(15px) !important;
    transition: all 200ms linear !important;
}

.prgoress_indicator.active-progress {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) !important;
}

.prgoress_indicator::after {
  position: absolute;
  content: "\f106";
  font-family: "Font Awesome 5 Free";
  text-align: center;
  line-height: 46px;
  font-size: 18px;
  color:var( --primary-color);
  left: 0;
  top: 0;
  height: 46px;
  width: 46px;
  cursor: pointer;
  display: block;
  font-weight: 900;
  z-index: 1;
  transition: all 200ms linear !important;
}

.prgoress_indicator::before {
  position: absolute;
  content: "\f106";
  font-family: "Font Awesome 5 Free";
  text-align: center;
  line-height: 46px;
  font-size: 18px;
  font-weight: 900;
  opacity: 0;
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  left: 0;
  top: 0;
  height: 46px;
  width: 46px;
  cursor: pointer;
  display: block;
  z-index: 2;
  transition: all 200ms linear !important;
}
.prgoress_indicator:hover ::after {
  color:var(--Secondary-color);
}
.prgoress_indicator:hover ::before {
  opacity: 1;
}
.prgoress_indicator svg path {
  fill: none;
}
.prgoress_indicator svg.progress-circle path {
  stroke:var(--primary-color);
  stroke-width: 4;
  box-sizing: border-box;
  transition: all 200ms linear !important;
}

/* ==========================================================
   MERAIR TRAVELS — Brand Override for Travelik Template
   Navy #0F1B3C · Red #E63946 · Gold #D4A574
   Playfair Display (display) + Poppins (body)
   ========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&family=Poppins:wght@300;400;500;600;700;800&display=swap');

:root {
    /* core brand colors mapped onto template variables */
    --color-btn: #E63946;          /* primary CTA red (was cyan) */
    --color-btn1: #0F1B3C;         /* navy dark button */
    --primary-color: #D4A574;      /* gold accent (icons, highlights) */
    --title-color: #fff;
    --text-color: #A9B0C4;

    --theme-bg-color: #0F1B3C;     /* main dark navy bg */
    --theme-bg-color2: #0A1329;    /* darker navy bg */
    --theme-bg-color3: #F3E9DC;    /* soft gold-tinted light bg */
    --theme-bg-color4: #F8F6F1;    /* cream light bg */
    --theme-bg-color5: #16234A;    /* navy variant */

    --color-white2: #F8F6F1;
    --title-color2: #0F1B3C;

    /* typography */
    --text-font: "Poppins", sans-serif;
    --title-font: "Playfair Display", serif;
    --style-font: "Playfair Display", serif;

    --merair-gold: #D4A574;
    --merair-red: #E63946;
    --merair-navy: #0F1B3C;
}

/* style-font is used for italic eyebrow/script text in the template —
   force italic weight since Playfair Display carries the "signature" feel */
[style*="var(--style-font)"],
.sub-title,
.wow.fadeInUp .sub-title {
    font-style: italic;
}

/* Header logo: transparent header shows a white silhouette of the logo,
   solid/sticky header + footer show the full navy & red mark */
.header-logo .active_logo img {
    filter: brightness(0) invert(1);
    height: 42px;
    width: auto;
}
.header-logo .logo_two img,
.mobile-logo img,
.footer-logo img,
.nav-logo img {
    height: 46px;
    width: auto;
}
.sticky .header-logo .active_logo img {
    filter: none;
}

/* Buttons: ensure red CTA has readable white text and consistent hover */
.theme-btn {
    font-family: var(--text-font);
    letter-spacing: .3px;
}

/* Section eyebrow/kicker labels in gold */
.section-title span,
.sub-title {
    color: var(--merair-gold) !important;
}

/* Headings always Playfair Display */
h1, h2, h3, h4, h5,
.section-title h2,
.title {
    font-family: var(--title-font);
}

/* Preloader override — logo intro video instead of spinner */
.preloader {
    background: var(--merair-navy);
    display: flex;
    align-items: center;
    justify-content: center;
}
.preloader video {
    width: min(560px, 70vw);
    height: auto;
}
.preloader .loader {
    display: none;
}

/* Trip-finder tab active state uses gold underline instead of cyan */
.add-bg.active,
.tab-buttons .active {
    border-color: var(--merair-gold) !important;
}

/* Misc link/hover accents */
a:hover,
.nav_scroll li a:hover {
    color: var(--merair-gold);
}

