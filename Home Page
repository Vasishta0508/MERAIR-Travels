    border-radius: 50%;
    text-align: center;
    margin: auto;
}

.marque-circle:before {
    position: absolute;
    content: '';
    left: -54%;
    top: 26px;
    height: 244px;
    width: 244px;
    border: 1px solid #ffffff38;
    border-radius: 50%;
}

.marque-circle::after {
    position: absolute;
    content: '';
    right: -54%;
    top: 26px;
    height: 244px;
    width: 244px;
    border: 1px solid #ffffff38;
    border-radius: 50%;
}

.marque-circle svg {
    width: 90%;
    max-width: 90%;
    height: auto;
    overflow: visible;
    word-spacing: 14px;
    transform: rotate(0) scaleX(1) scaleY(1);
}

